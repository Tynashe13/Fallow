# ── Fallow environment ────────────────────────────────────────────────
# Copy to .env.local and fill in what you have. Every key is OPTIONAL:
# the app runs on keyless open data (NASA POWER, ISRIC SoilGrids,
# Open-Meteo, met.no, AWS Terrain Tiles, OpenStreetMap) without any of
# these. Keys unlock the extra panels marked "needs key" in the UI.

# Google Gemini — powers the farm analysis drawer (crop rotation,
# planting windows, risk read). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.0-flash
GEMINI_MODEL=

# iSDA Africa soil map (30 m resolution, Africa only) — second opinion
# next to SoilGrids in the topsoil comparison. https://www.isda-africa.com/isdasoil/
ISDA_USERNAME=
ISDA_PASSWORD=

# Meteomatics — fourth independent rain source in the annual-rain
# comparison. https://www.meteomatics.com/en/api/getting-started/
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Open-Meteo commercial key (only needed if you hit the free rate limit)
OPEN_METEO_API_KEY=
